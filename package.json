{
  "name": "rowbase",
  "version": "0.1.3",
  "description": "Rowbase — interactive Notion-style database with multiple views, formulas, rollups, relations, and more.",
  "main": "main.js",
  "license": "MIT",
  "author": "soulaymane",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soulaymane01/rowbase.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test:metadata": "node test-baseline-metadata.mjs",
    "test:offline": "node test-offline-baseline.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:rbase": "tsx --test test/csv-parser.test.ts",
    "test:chart": "tsx --test test/chart.test.ts",
    "test:query": "tsx --test test/group.test.ts test/query-resolve.test.ts test/query-compare.test.ts test/query-filter.test.ts test/query-sort.test.ts",
    "test:formula": "tsx --test test/formula.test.ts",
    "test:rollup": "tsx --test test/rollup.test.ts",
    "test:aggregate": "tsx --test test/aggregate.test.ts",
    "test:stats": "tsx --test test/stats.test.ts",
    "test:timeline": "tsx --test test/timeline.test.ts",
    "test:dashboard": "tsx --test test/dashboard.test.ts",
    "test:relations": "tsx --test test/relations.test.ts",
    "test:queryFormula": "tsx --test test/query-formula.test.ts",
    "check:baseline": "npm run typecheck && npm run test:metadata && npm run test:rbase && npm run test:query && npm run test:chart && npm run test:stats && npm run test:formula && npm run test:rollup && npm run test:aggregate && npm run test:timeline && npm run test:dashboard && npm run test:relations && npm run test:queryFormula && npm run build && npm run test:offline"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^16.11.6",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.17.3",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "papaparse": "^5.4.1",
    "preact": "^10.29.8"
  }
}
